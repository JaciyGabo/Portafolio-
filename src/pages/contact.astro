---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const formspreeId = 'your-formspree-id'; // Replace with actual Formspree form ID
---

<BaseLayout
  title="Contacto"
  description="¿Tienes un proyecto en mente? Contáctame para discutir cómo puedo ayudarte."
>
  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <h1 class="text-4xl md:text-5xl font-bold mb-4">
            <span class="bg-gradient-to-r from-electric-400 to-tech-400 bg-clip-text text-transparent">
              Contacto
            </span>
          </h1>
          <p class="text-gray-400 max-w-2xl mx-auto">
            ¿Tienes un proyecto en mente? Estoy disponible para discutir cómo puedo ayudarte a transformar tu idea en realidad.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-12">
          <!-- Contact Form -->
          <div class="card">
            <h2 class="text-2xl font-semibold mb-6 text-gray-100">Envíame un mensaje</h2>
            <form
              action={`https://formspree.io/f/${formspreeId}`}
              method="POST"
              class="space-y-6"
            >
              <div>
                <label for="name" class="block text-sm font-medium text-gray-300 mb-2">
                  Nombre
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 bg-dark-800 border border-dark-600 rounded-lg text-gray-100 focus:outline-none focus:border-electric-500 transition-colors"
                  placeholder="Tu nombre"
                />
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
                  Email
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 bg-dark-800 border border-dark-600 rounded-lg text-gray-100 focus:outline-none focus:border-electric-500 transition-colors"
                  placeholder="tu@email.com"
                />
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-gray-300 mb-2">
                  Mensaje
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  class="w-full px-4 py-3 bg-dark-800 border border-dark-600 rounded-lg text-gray-100 focus:outline-none focus:border-electric-500 transition-colors resize-none"
                  placeholder="Cuéntame sobre tu proyecto..."
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full btn-primary"
              >
                Enviar mensaje
              </button>
            </form>
          </div>

          <!-- Contact Info -->
          <div class="space-y-8">
            <div class="card">
              <h2 class="text-2xl font-semibold mb-6 text-gray-100">Información de contacto</h2>

              <div class="space-y-4">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-lg bg-electric-500/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-electric-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-gray-500 mb-1">Email</p>
                    <a href={`mailto:${profile.email}`} class="text-gray-100 hover:text-electric-400 transition-colors">
                      {profile.email}
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <div class="card">
              <h2 class="text-2xl font-semibold mb-6 text-gray-100">Redes sociales</h2>

              <div class="flex gap-4">
                {profile.social.github && (
                  <a
                    href={profile.social.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-12 h-12 rounded-lg bg-dark-700 flex items-center justify-center hover:bg-electric-500/20 hover:border-electric-500 border border-transparent transition-all group"
                  >
                    <svg class="w-6 h-6 text-gray-400 group-hover:text-electric-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                  </a>
                )}

                {profile.social.linkedin && (
                  <a
                    href={profile.social.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-12 h-12 rounded-lg bg-dark-700 flex items-center justify-center hover:bg-electric-500/20 hover:border-electric-500 border border-transparent transition-all group"
                  >
                    <svg class="w-6 h-6 text-gray-400 group-hover:text-electric-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                  </a>
                )}

                {profile.social.twitter && (
                  <a
                    href={profile.social.twitter}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-12 h-12 rounded-lg bg-dark-700 flex items-center justify-center hover:bg-electric-500/20 hover:border-electric-500 border border-transparent transition-all group"
                  >
                    <svg class="w-6 h-6 text-gray-400 group-hover:text-electric-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>

            <div class="card bg-gradient-to-br from-dark-800 to-dark-900 border-electric-500/20">
              <p class="text-gray-300 text-center">
                <span class="text-electric-400 font-semibold">Disponible</span> para proyectos freelance y colaboraciones.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>